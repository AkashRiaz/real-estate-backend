<%- include('partials/header', { title: 'Reset your password' }) %>
<h1 style="margin:0 0 16px;font-size:22px;">Reset your password</h1>
<p style="margin:0 0 16px;line-height:1.6;">Hi <%= name %>, we received a request to reset your EstateHub password. Use the code below to continue.</p>
<p style="margin:24px 0;text-align:center;">
  <span style="display:inline-block;padding:14px 28px;background:#ccfbf1;color:#115e59;border-radius:12px;font-size:28px;letter-spacing:8px;font-weight:700;"><%= otp %></span>
</p>
<p style="margin:0 0 8px;line-height:1.6;">This code expires in <strong><%= expirationMinutes %> minutes</strong>.</p>
<p style="margin:0;line-height:1.6;color:#64748b;">If you didn't ask to reset your password, you can ignore this email. Your account stays secure.</p>
<%- include('partials/footer') %>
