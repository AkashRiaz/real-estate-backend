<%- include('partials/header', { title: title }) %>
<h1 style="margin:0 0 16px;font-size:22px;"><%= title %></h1>
<p style="margin:0 0 16px;line-height:1.6;">Hi <%= name %>,</p>
<p style="margin:0 0 20px;line-height:1.6;"><%= message %></p>
<% if (details && details.length) { %>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:0 0 24px;border:1px solid #e2e8f0;border-radius:12px;">
  <% details.forEach(function (row) { %>
  <tr>
    <td style="padding:10px 16px;color:#64748b;font-size:14px;border-bottom:1px solid #e2e8f0;"><%= row.label %></td>
    <td style="padding:10px 16px;font-size:14px;font-weight:600;border-bottom:1px solid #e2e8f0;text-align:right;"><%= row.value %></td>
  </tr>
  <% }) %>
</table>
<% } %>
<% if (actionUrl) { %>
<p style="margin:0;text-align:center;">
  <a href="<%= actionUrl %>" style="display:inline-block;padding:12px 24px;background:#0f766e;color:#ffffff;text-decoration:none;border-radius:12px;font-weight:600;"><%= actionText %></a>
</p>
<% } %>
<%- include('partials/footer') %>
